# Copy to .env. `python -m leadfinder audit <url>` needs none of these.

# Supabase project URL and publishable key. Access codes are checked inside the database functions.
SUPABASE_URL=
SUPABASE_KEY=
# The agents' access code (worker, features, recheck, briefs)
WORKER_CODE=
# Only for `python -m leadfinder queue`
ADMIN_CODE=

# Optional: free Groq key (console.groq.com/keys) for judgement calls and sales briefs
GROQ_API_KEY=

# Morning lead email: Gmail address, its app password, who receives it, and the app link in the email
GMAIL_USER=
GMAIL_APP_PASSWORD=
REPORT_TO=
APP_URL=
